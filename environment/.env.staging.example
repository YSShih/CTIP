# CTIP — staging 環境樣板(docs/spec/05-environment.md §5.5)
# 使用:cp environment/.env.staging.example environment/.env.staging 後填入真實值。
# 服務:全部(COMPOSE_PROFILES=full)。
# 本檔不得出現任何掛載變數——原始碼掛載依 compose 預設值退化為 .noop 空目錄。

# ---------- 執行模式 ----------
PROJECT_NAME=ctip
ENVIRONMENT=staging
COMPOSE_PROFILES=full
RESTART_POLICY=unless-stopped

# ---------- 建置 ----------
BACKEND_BUILD_TARGET=production
BACKEND_JAVA_OPTS=
FRONTEND_BUILD_TARGET=production
FRONTEND_CONTAINER_PORT=80

# ---------- 網路綁定 ----------
# debug port 5005 維持 compose 預設(127.0.0.1),且 production 映像內無 JDWP agent。
BACKEND_BIND=0.0.0.0:8080
FRONTEND_BIND=0.0.0.0:80
POSTGRES_BIND=0.0.0.0:5432
REDIS_BIND=0.0.0.0:6379

# ---------- 資料儲存 ----------
POSTGRES_DB=ctip
POSTGRES_USER=ctip
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_APP_USER=ctip_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
POSTGRES_RETENTION_USER=ctip_retention
POSTGRES_RETENTION_PASSWORD=CHANGE_ME_RETENTION_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NOTIFICATION_TRANSPORT=kafka
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_SECURITY_ENABLED=false
SEARCH_BACKEND=elasticsearch
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ---------- 應用程式 ----------
SPRING_PROFILES_ACTIVE=staging
JWT_SECRET=CHANGE_ME_MIN_32_BYTES_REPLACE_THIS
WEBHOOK_SECRET_KEK=CHANGE_ME_WEBHOOK_KEK_REPLACE_THIS
CORS_ALLOWED_ORIGINS=https://ctip-staging.example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
# 若 backend 前面加了 LB／反向代理,填它的來源網段(例:10.0.0.0/8);
# 留空代表不採信 X-Forwarded-*,限流會把所有 client 當成同一個位址(見 docs/deployment/rate-limiting.md)
TRUSTED_PROXIES=
SCHEDULER_ENABLED=true

# --- 應用層可調參數(05 §5.4.5;與 application.yml 對稱,勿只改一邊) ---
# 方案配額覆寫(JSON,選填;空字串 = 完全依 plans 表的種子值)
# 例:CTIP_PLAN_OVERRIDES={"PREMIUM":{"maxApiKeys":20}}
CTIP_PLAN_OVERRIDES=
SOURCE_SYNC_CRON=0 */5 * * * *
IOC_EXPIRY_CRON=0 0 3 * * *
INGESTION_RETRY_CRON=0 */15 * * * *
NORMALIZATION_STRIP_WWW=false
DOMAIN_ALLOWLIST=
API_DEFAULT_PAGE_SIZE=50
BLOOM_STORAGE_DIR=/var/lib/ctip/bloom
BLOOM_COMPRESSION=ZSTD
SWAGGER_ENABLED=true
ACTUATOR_EXPOSED_ENDPOINTS=health,info

# ---------- 前端(公開) ----------
VITE_ENVIRONMENT=staging
VITE_API_URL=https://api.ctip-staging.example.com
VITE_WS_URL=wss://api.ctip-staging.example.com

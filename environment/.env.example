# =============================================================================
# CTIP 環境變數總覽(說明用樣板)
# 依 docs/spec/05-environment.md §5.4;各環境實際取值見 §5.5 差異表與
# .env.{mvp,dev,staging,prod}.example。
#
# 使用方式:複製對應環境的樣板後填入真實值,例如
#   cp environment/.env.mvp.example environment/.env.mvp
# 真實 .env 檔已被 .gitignore 排除,絕不進版控。
#
# 標示 [SECRET] 的變數:樣板中一律為明顯假值(CHANGE_ME_*);
# prod 的值必須來自 secret manager / 部署平台 secret,絕不進 Git。
# =============================================================================

# ---------- 執行模式(§5.4.1) ----------
# COMPOSE_PROFILES 由 Docker Compose CLI 讀取,決定啟動哪些帶 profiles: 的服務;
# 它不出現在 compose 檔內。空 = 僅 frontend/backend/postgres;standard = +redis;
# full = +kafka/elasticsearch/prometheus/grafana。
PROJECT_NAME=ctip
ENVIRONMENT=mvp                      # mvp | dev | staging | prod(必須傳入容器)
COMPOSE_PROFILES=                    # 空 | standard | full
RESTART_POLICY=no                    # no | unless-stopped | always

# ---------- 建置與掛載(§5.4.2) ----------
# staging / prod 不得設定任何 *_MOUNT_* 變數(依 compose 預設值掛 .noop 空目錄)。
BACKEND_BUILD_TARGET=development     # development | production
BACKEND_MOUNT_SRC=../backend
BACKEND_MOUNT_DST=/workspace
BACKEND_MOUNT_MODE=rw
MAVEN_CACHE_SRC=maven-cache          # named volume(已於 compose 頂層宣告)
MAVEN_CACHE_DST=/root/.m2
BACKEND_JAVA_OPTS=                   # dev/mvp 放 JDWP agent;prod 放 -XX:MaxRAMPercentage=75
FRONTEND_BUILD_TARGET=development    # development | production
FRONTEND_MOUNT_SRC=../frontend
FRONTEND_MOUNT_DST=/workspace
FRONTEND_MOUNT_MODE=rw
FRONTEND_CONTAINER_PORT=5173         # 5173 (vite dev) | 80 (nginx)

# ---------- 網路綁定(§5.4.3) ----------
# 開發環境一律綁 127.0.0.1,避免服務意外曝露到區網。
# debug port 5005 在所有環境都只綁 127.0.0.1(見 compose 註記)。
BACKEND_BIND=127.0.0.1:8080
BACKEND_DEBUG_BIND=127.0.0.1:5005
FRONTEND_BIND=127.0.0.1:5173
POSTGRES_BIND=127.0.0.1:5432
REDIS_BIND=127.0.0.1:6379

# ---------- 資料儲存(§5.4.4) ----------
POSTGRES_DB=ctip
POSTGRES_USER=ctip
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD     # [SECRET]
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD           # [SECRET]
KAFKA_BOOTSTRAP_SERVERS=kafka:9092                # [M3] full profile 才有 kafka
ELASTICSEARCH_URL=http://elasticsearch:9200       # [M2] full profile 才有 es
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME_ELASTICSEARCH_PASSWORD  # [SECRET]
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_SECURITY_ENABLED=false            # 僅 dev/staging 可為 false;prod 必須 true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD  # [SECRET] 僅 full profile 需要

# ---------- 應用程式(§5.4.5) ----------
SPRING_PROFILES_ACTIVE=mvp
BACKEND_PORT=8080
FRONTEND_PORT=5173

JWT_SECRET=CHANGE_ME_MIN_32_BYTES    # [SECRET] >= 32 bytes;prod 必須來自 secret manager
JWT_ACCESS_TOKEN_EXPIRATION=900      # 秒
JWT_REFRESH_TOKEN_EXPIRATION=2592000 # 秒

CORS_ALLOWED_ORIGINS=http://localhost:5173   # prod 絕不允許 *
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory            # memory | redis(僅 mvp 用 memory)

BLOOM_PUBLIC_CAPACITY=10000000
BLOOM_PUBLIC_FALSE_POSITIVE_RATE=0.001
BLOOM_TENANT_DEFAULT_CAPACITY=1000000
BLOOM_SNAPSHOT_CRON=0 0 4 * * *
BLOOM_DELTA_CRON=0 0 * * * *
BLOOM_MAX_DELTA_CHAIN=24

SCHEDULER_ENABLED=true
INGESTION_ENABLED=true
INGESTION_BATCH_SIZE=500

SWAGGER_ENABLED=true                 # prod 必須 false
ACTUATOR_EXPOSED_ENDPOINTS=health,info

# 資料保留政策(天)
AUDIT_RETENTION_DAYS=180
RAW_PAYLOAD_RETENTION_DAYS=30
REJECTION_RETENTION_DAYS=30
DELIVERY_RETENTION_DAYS=30
INDICATOR_RETENTION_DAYS=365
BLOOM_ARTIFACT_KEEP=30

# ---------- 前端(§5.4.6,公開) ----------
# 任何 VITE_ 開頭的變數都會被打包進 bundle,視為公開資訊,絕不放後端 secret。
VITE_ENVIRONMENT=mvp
VITE_API_URL=http://localhost:8080
VITE_WS_URL=

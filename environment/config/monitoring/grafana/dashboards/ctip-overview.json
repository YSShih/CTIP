{
  "uid": "ctip-overview",
  "title": "CTIP Overview",
  "tags": [ "ctip" ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / sec by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (status)" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency by uri",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "JVM heap used",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [ { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HikariCP active connections",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [ { "refId": "A", "expr": "hikaricp_connections_active" } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backend up",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [ { "refId": "A", "expr": "up{job=\"ctip-backend\"}" } ]
    }
  ]
}

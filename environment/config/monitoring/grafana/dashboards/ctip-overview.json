{
  "uid": "ctip-overview",
  "title": "CTIP Overview",
  "tags": [
    "ctip"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / sec by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (status)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency by uri",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "JVM heap used",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "HikariCP active connections",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backend up",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"ctip-backend\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingestion records / sec by result",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ctip_ingestion_records_total[5m])) by (result)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingestion stage p95 duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ctip_ingestion_stage_duration_seconds_bucket[5m])) by (le, stage))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Source sync lag (seconds)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ctip_source_sync_lag_seconds"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Rate limit rejections / sec by dimension",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ctip_ratelimit_rejected_total[5m])) by (dimension)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Bloom generation p95 duration by scope",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(ctip_bloom_generation_duration_seconds_bucket[5m])) by (le, scope))"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Redistribution filtered / sec by policy",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ctip_redistribution_filtered_total[5m])) by (policy)"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Kafka consumer lag",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_lag"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Elasticsearch cluster health (2=green)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "elasticsearch_cluster_health"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Redis command latency p95 (lettuce)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(lettuce_command_completion_seconds_bucket[5m])) by (le, command))"
        }
      ]
    }
  ]
}

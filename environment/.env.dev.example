# CTIP — dev 環境樣板(docs/spec/05-environment.md §5.5)
# 使用:cp environment/.env.dev.example environment/.env.dev 後填入真實值。
# 服務:frontend, backend, postgres + redis(COMPOSE_PROFILES=standard;不得用 full)。

# ---------- 執行模式 ----------
PROJECT_NAME=ctip
ENVIRONMENT=dev
COMPOSE_PROFILES=standard
RESTART_POLICY=no

# ---------- 建置與掛載 ----------
BACKEND_BUILD_TARGET=development
BACKEND_MOUNT_SRC=../backend
BACKEND_MOUNT_DST=/workspace
BACKEND_MOUNT_MODE=rw
MAVEN_CACHE_SRC=maven-cache
MAVEN_CACHE_DST=/root/.m2
BACKEND_JAVA_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
FRONTEND_BUILD_TARGET=development
FRONTEND_MOUNT_SRC=../frontend
FRONTEND_MOUNT_DST=/workspace
FRONTEND_MOUNT_MODE=rw
# host port 與容器 port 必須一致(皆 5173),否則 Vite HMR 靜默失效(§5.5 修正 2)
FRONTEND_CONTAINER_PORT=5173

# ---------- 網路綁定(開發一律 127.0.0.1) ----------
BACKEND_BIND=127.0.0.1:8080
BACKEND_DEBUG_BIND=127.0.0.1:5005
FRONTEND_BIND=127.0.0.1:5173
POSTGRES_BIND=127.0.0.1:5432
REDIS_BIND=127.0.0.1:6379

# ---------- 資料儲存 ----------
POSTGRES_DB=ctip
POSTGRES_USER=ctip
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ---------- 應用程式 ----------
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=CHANGE_ME_MIN_32_BYTES
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
SCHEDULER_ENABLED=true
SWAGGER_ENABLED=true
ACTUATOR_EXPOSED_ENDPOINTS=health,info

# ---------- 前端(公開) ----------
VITE_ENVIRONMENT=dev
VITE_API_URL=http://localhost:8080
VITE_WS_URL=

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ctip</groupId>
    <artifactId>ctip-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ctip-app</artifactId>
  <name>CTIP App</name>
  <properties>
    <!-- 覆寫 parent 的預設:只有本模組執行 spring-boot:run -->
    <spring-boot.run.skip>false</spring-boot.run.skip>
  </properties>
  <description>Spring Boot 啟動類、infrastructure、interfaces、Flyway、設定檔。唯一產生可執行 jar 的模組</description>

  <dependencies>
    <dependency>
      <groupId>com.ctip</groupId>
      <artifactId>ctip-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ctip</groupId>
      <artifactId>ctip-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ctip</groupId>
      <artifactId>ctip-adapters</artifactId>
    </dependency>

    <!-- 以下版本一律由 Spring Boot BOM 納管(docs/spec/06-tech-stack.md §6.1.3) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 認證與授權(docs/spec/06-tech-stack.md §6.2.2:Spring Security 7.1.x,版本由 BOM 決定) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!--
      JWT(HS256)簽發與驗證。版本表未列 JWT 函式庫;採 Spring Security 自帶的 JOSE 支援
      (Nimbus,同樣由 Boot BOM 納管),不新增任何版本 property(ADR 0012 決策 7)。
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Boot 4 模組化:Flyway 的 auto-configuration 在獨立模組,缺少它 Flyway 不會執行 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- MapStruct 註解(processor 已在 parent 的 annotationProcessorPaths;06 §6.1.3 版本集中於 parent properties) -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>
    <!-- OpenAPI / Swagger UI(docs/spec/09-api.md §9.6;SWAGGER_ENABLED 控制,prod 預設關) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- 記憶體限流(docs/spec/10-identity-plans.md §10.7;版本見 parent properties) -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <!-- Bloom artifact 的預設壓縮(docs/spec/11-sync-bloom.md §11.4;06 §6.2.2,版本見 parent properties)。
         JDK 只內建 GZIP/Deflate,ZSTD 需要這個相依;壓縮只影響傳輸與儲存,不影響 checksum。 -->
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
      <version>${zstd.version}</version>
    </dependency>
    <!-- Hot reload 契約(docs/spec/05-environment.md §5.11):reload.sh 觸發重編後由 DevTools 重啟 context -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- STIX 2.1 JSON Schema 驗證(StixSchemaValidationTest;僅測試,ADR 0005) -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 模組化(06 §6.3.6 同型態):MockMvc 測試支援移至 per-tech 模組 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x(Boot 4 BOM 納管)的 artifact 名帶 testcontainers- 前綴 -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            JDWP 掛在 run goal 而非 BACKEND_JAVA_OPTS(ADR 0001 決策 3):
            compose 把 BACKEND_JAVA_OPTS 注入 JAVA_TOOL_OPTIONS,dev 容器跑 mvnw spring-boot:run
            時 Maven JVM 與 forked app JVM 都會讀它,第二個 JVM 綁 5005 必然失敗。
            此設定只影響 spring-boot:run(開發容器);production 走 java -jar,不受影響。
          -->
          <jvmArguments>-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005</jvmArguments>
          <!--
            DevTools trigger file 的載體目錄(ADR 0010):.devtools/ 加入 spring-boot:run 的
            classpath,restart 只由 reload.sh 觸碰 .reloadtrigger 觸發——host 端 mvn 重建共享的
            target/classes 不再引發容器內熱重啟(半寫入 classpath 曾使 app context 死亡)。
            只影響 spring-boot:run(開發容器);production 走 java -jar,不受影響。
          -->
          <additionalClasspathElements>
            <additionalClasspathElement>${project.basedir}/.devtools</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <!-- 覆蓋率排除(docs/spec/14-testing.md §14.3):Spring 組態類、啟動類、MapStruct 產物 -->
          <excludes>
            <exclude>com/ctip/config/**</exclude>
            <exclude>com/ctip/CtipApplication.class</exclude>
            <exclude>**/*MapperImpl.class</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

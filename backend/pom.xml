<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.ctip</groupId>
  <artifactId>ctip-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CTIP Parent</name>
  <description>Cyber Threat Intelligence Platform - Maven parent</description>

  <modules>
    <module>ctip-sdk</module>
    <module>ctip-core</module>
    <module>ctip-adapters</module>
    <module>ctip-app</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <!-- 未由 Spring Boot BOM 納管的相依/外掛,集中於此(docs/spec/06-tech-stack.md §6.1.3) -->
    <mapstruct.version>1.6.3</mapstruct.version>
    <archunit.version>1.4.2</archunit.version>
    <!--
      06 §6.2 中未由 Spring Boot BOM 納管者(§6.1.3 規則 2:必須在 parent 集中定義)。
      這三項供後續 phase 使用,現階段尚未有任何 module 宣告相依——先定版本,
      使該 phase 不必為了「版本表沒有」而卡住(規則 6),見 ADR 0018。
    -->
    <zstd.version>1.5.7-16</zstd.version>
    <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <!-- 06 §6.2:Resilience4j 2.3.x、Bucket4j 8.x(僅標 major 系列,取系列內現行版) -->
    <resilience4j.version>2.3.0</resilience4j.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <!-- 3.x 才相容 Spring Boot 4,不得使用 2.x(docs/spec/06-tech-stack.md §6.2、09 §9.6) -->
    <springdoc.version>3.1.0</springdoc.version>
    <!-- 僅測試用:STIX 2.1 JSON Schema 驗證(M1-29);版本表無 schema 驗證器,依 ADR 0005 以 test scope 引入 -->
    <json-schema-validator.version>1.5.9</json-schema-validator.version>
    <spotless-maven-plugin.version>2.46.1</spotless-maven-plugin.version>
    <palantir-java-format.version>2.97.0</palantir-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <!-- 測試分層(docs/spec/14-testing.md §14.1):預設只跑 L1(unit) -->
    <ctip.test.excludedGroups>slice,integration,heavy</ctip.test.excludedGroups>
    <!-- 測試逾時契約(docs/spec/14-testing.md §14.8)。以 -D 覆寫,例如 -Dctip.test.timeout=60s -->
    <ctip.test.timeout>30s</ctip.test.timeout>
    <!--
      surefire 平行 fork(ADR 0053)。每個 fork 是獨立 JVM,而所有 Testcontainers 容器
      都宣告為 static ⇒ **每個 fork 各自一組容器,DB state 不共用**;測試一律用
      RANDOM_PORT / server.port=0,暫存目錄用 Files.createTempDirectory,因此沒有共用狀態。
      覆蓋率以 per-fork destfile + jacoco:merge 處理(見下方 jacoco 設定)。
      量測或回退用 -Dctip.test.forkCount=1。
    -->
    <ctip.test.forkCount>2</ctip.test.forkCount>
    <ctip.test.lifecycle.timeout>5m</ctip.test.lifecycle.timeout>
    <!-- 各 module 以此覆寫行覆蓋率下限(docs/spec/14-testing.md §14.3);ctip-core 另以套件層級規則覆寫 -->
    <ctip.coverage.line-minimum>0.60</ctip.coverage.line-minimum>
    <!-- dev 容器 CMD 為 `mvnw -pl ctip-app -am spring-boot:run`,run goal 會對 reactor 每個
         module 執行;只有 ctip-app 有 main class,其餘一律跳過(ctip-app pom 覆寫為 false) -->
    <spring-boot.run.skip>true</spring-boot.run.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.ctip</groupId>
        <artifactId>ctip-sdk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ctip</groupId>
        <artifactId>ctip-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.ctip</groupId>
        <artifactId>ctip-adapters</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>25</release>
            <proc>full</proc>
            <compilerArgs>
              <arg>-parameters</arg>
              <arg>-Xlint:all</arg>
              <!-- 全域 annotationProcessorPaths(MapStruct)在無註解可處理的 module 會觸發
                   processing 警告,與 sdk/core 的 -Werror 衝突;僅關閉此項 lint -->
              <arg>-Xlint:-processing</arg>
            </compilerArgs>
            <annotationProcessorPaths>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <java>
              <palantirJavaFormat>
                <version>${palantir-java-format.version}</version>
              </palantirJavaFormat>
            </java>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/ctip-checks.xml</configLocation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failsOnError>true</failsOnError>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
              <configuration>
                <!--
                  ⚠️ 兩個 fork 寫同一個 jacoco.exec 會讓覆蓋率失真,而 M1-02 正是對這個數字
                  下斷言——往哪個方向誤判都有可能。${surefire.forkNumber} 由 surefire 在
                  fork 時代換(Maven 解析階段保留字面值),每個 fork 因此各寫一份。
                -->
                <destFile>${project.build.directory}/jacoco-${surefire.forkNumber}.exec</destFile>
              </configuration>
            </execution>
            <execution>
              <!-- 必須排在 report / check 之前:同一個 phase 內依宣告順序執行 -->
              <id>merge-forks</id>
              <goals>
                <goal>merge</goal>
              </goals>
              <phase>verify</phase>
              <configuration>
                <fileSets>
                  <fileSet>
                    <directory>${project.build.directory}</directory>
                    <includes>
                      <include>jacoco-*.exec</include>
                    </includes>
                  </fileSet>
                </fileSets>
                <!-- 合併回既有路徑:report / check 與 dod.sh 的 dod_coverage_threshold 都不必改 -->
                <destFile>${project.build.directory}/jacoco.exec</destFile>
              </configuration>
            </execution>
            <execution>
              <id>report</id>
              <goals>
                <goal>report</goal>
              </goals>
              <phase>verify</phase>
            </execution>
            <execution>
              <id>check</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>verify</phase>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${ctip.coverage.line-minimum}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludedGroups>${ctip.test.excludedGroups}</excludedGroups>
            <!-- 規格與 DoD 的判準以 -Dtest=<類名> 在 reactor 根執行;
                 沒有該測試類的 module(如 ctip-sdk)不得因此失敗 -->
            <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
            <forkCount>${ctip.test.forkCount}</forkCount>
            <!--
              測試逾時契約(docs/spec/14-testing.md §14.8)。四個 module 只有 ctip-app 有
              src/test/resources,與其塞四份 junit-platform.properties,不如在此一處設定
              ——JUnit Platform 也從 system property 讀設定參數,且 -D 可直接覆寫。

              測試方法與 lifecycle 方法分開計:@BeforeAll/@BeforeEach 可能觸發
              Testcontainers 與 Spring context 啟動,套 30 秒必然誤殺。

              ⚠️ thread.mode 必須是 SEPARATE_THREAD。預設的 SAME_THREAD **不會中斷卡住的呼叫**,
              只在方法自己回來之後才判定超時——卡在 TCP connect 或壞掉的 Testcontainers 連線的
              測試照樣卡滿再報失敗,一秒都沒省到(2026-08-31 那次過夜卡死 8 小時 51 分即此類)。
            -->
            <systemPropertyVariables>
              <junit.jupiter.execution.timeout.testable.method.default>${ctip.test.timeout}</junit.jupiter.execution.timeout.testable.method.default>
              <junit.jupiter.execution.timeout.lifecycle.method.default>${ctip.test.lifecycle.timeout}</junit.jupiter.execution.timeout.lifecycle.method.default>
              <junit.jupiter.execution.timeout.thread.mode.default>SEPARATE_THREAD</junit.jupiter.execution.timeout.thread.mode.default>
              <junit.jupiter.execution.timeout.mode>disabled_on_debug</junit.jupiter.execution.timeout.mode>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <!--
        migrate.sh(05 §5.10)以 `mvnw -N flyway:migrate` 呼叫。宣告在 parent 而非 ctip-app:
        -N 不遞迴,因此不需解析模組相依(單獨 `-pl ctip-app` 會因 SNAPSHOT 未安裝而失敗),
        而 locations 直指 migration 目錄,plugin 本來就不需要專案 classpath。
        無 <executions>,不綁任何 lifecycle phase——只有明確呼叫 flyway:* 時才會執行;
        schema 的正常套用路徑仍是應用啟動時的 Flyway(05 §5.9)。
        版本與 flyway-database-postgresql 皆由 spring-boot-starter-parent 納管,不新增版本 property
        (06 §6.2 版本表未列此 plugin,依規則 17 回報)。
      -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <configuration>
          <locations>
            <location>filesystem:${maven.multiModuleProjectDirectory}/ctip-app/src/main/resources/db/migration</location>
          </locations>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <!-- plugin dependencies 不吃 dependencyManagement,須明寫;沿用 Boot 納管的 ${flyway.version} -->
            <version>${flyway.version}</version>
          </dependency>
          <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <!--
        CycloneDX SBOM(13 §13.8、DoD M3-20)。makeAggregateBom 在 reactor 最後一個 module
        跑一次,產出整個後端的合併 SBOM 於 backend/target/bom.json;綁在 package,
        因此 `mvnw package` 與 `mvnw verify` 都會產生,dod.sh 的 M3-20 只檢查存在性。
        版本未由 Boot BOM 納管,依 06 §6.1.3 規則 2 定義於本檔 <properties>。
      -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>aggregate-bom</id>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
            <phase>package</phase>
          </execution>
          <execution>
            <!-- plugin 自帶的預設 execution 會讓 makeAggregateBom 跑第二次
                 (實測 log 裡 `(default)` 與 `(aggregate-bom)` 兩行都在)。停掉。 -->
            <id>default</id>
            <phase>none</phase>
          </execution>
        </executions>
        <configuration>
          <projectType>application</projectType>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
          <!-- SBOM 描述的是可佈署產物的相依,test scope 不隨映像檔出貨 -->
          <includeTestScope>false</includeTestScope>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- 測試分層 profile(docs/spec/14-testing.md §14.1) -->
    <profile>
      <id>test-slice</id>
      <properties>
        <ctip.test.excludedGroups>integration,heavy</ctip.test.excludedGroups>
      </properties>
    </profile>
    <profile>
      <id>test-integration</id>
      <properties>
        <ctip.test.excludedGroups>heavy</ctip.test.excludedGroups>
      </properties>
    </profile>
    <profile>
      <id>test-all</id>
      <properties>
        <ctip.test.excludedGroups/>
      </properties>
    </profile>
  </profiles>
</project>
